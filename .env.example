# Скопируйте в .env (локально) и/или внесите те же имена в Vercel → Project → Settings → Environment Variables.
# Реальные значения НЕ коммитить. .env в .gitignore.

# Публичные значения (анонимный ключ безопасен: доступ ограничен RLS). Есть значения по умолчанию
# в src/lib/supabase/config.ts, поэтому приложение стартует и без них.
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>

# СЕКРЕТЫ — только на Vercel (нужны для ночной синхронизации источников, /api/cron/sync-sources).
# Пока не заданы — синхронизация по расписанию отключена, остальное работает.
# Supabase → Project Settings → API → service_role (НИКОГДА не в git и не в клиентский код)
SUPABASE_SERVICE_ROLE_KEY=
# Любая длинная случайная строка (например: openssl rand -hex 32)
CRON_SECRET=

# Не используется (решение владельца: AI-поиск не подключаем). Оставлять пустым.
ANTHROPIC_API_KEY=
